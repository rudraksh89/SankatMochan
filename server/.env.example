PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/SankatMochan
JWT_SECRET=your_jwt_secret_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLIENT_URL=http://localhost:5173

# AI Key (Google Gemini API Key for Triage Guidance)
GEMINI_API_KEY=your_gemini_api_key_here

# Admin Portal Configuration
ADMIN_SECRET=your_admin_registration_secret
ADMIN_EMAIL=admin@sankatmochan.com
ADMIN_PASSWORD=Admin@123456

# Real Email OTP (Nodemailer SMTP Configuration)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="Sankat Mochan Support" <your_email@gmail.com>
